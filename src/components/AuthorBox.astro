---
import SocialLinks from './SocialLinks.astro';
import ProfilePhoto from './ProfilePhoto.astro';
import { SITE } from '../data/site';
---

<div class="flex flex-col gap-4 rounded-2xl border border-border bg-surface p-6 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex items-center gap-4">
    <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full">
      <ProfilePhoto size={96} />
    </div>
    <div>
      <p class="font-medium">Written by {SITE.name}</p>
      <p class="text-sm text-fg-muted">{SITE.description}</p>
    </div>
  </div>
  <SocialLinks />
</div>
