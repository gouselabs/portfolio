---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  class:list={[
    'inline-flex items-center rounded-md border border-border px-2.5 py-1 text-xs font-mono text-fg-muted transition-colors',
    href ? 'hover:border-fg hover:text-fg' : '',
    className,
  ]}
>
  <slot />
</Tag>
