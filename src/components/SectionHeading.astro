---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, description, align = 'left', class: className = '' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' ? 'mx-auto text-center' : '', className]}>
  {
    eyebrow && (
      <span
        class:list={[
          'mb-3 inline-flex items-center gap-2 rounded-full bg-accent-soft px-3 py-1 font-mono text-xs uppercase tracking-[0.2em] text-accent',
          align === 'center' ? 'mx-auto' : '',
        ]}
      >
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
        {eyebrow}
      </span>
    )
  }
  <h2 class="text-balance text-3xl font-medium sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-balance text-base text-fg-muted sm:text-lg">{description}</p>}
</div>
