---
import { getCollection } from 'astro:content';
import * as icons from '@lucide/astro';
import { Download, Briefcase, Rocket, Wrench, Terminal, Leaf, Workflow, Coffee, Cloud, Mail, FolderKanban, Lightbulb } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ToolCard from '../components/ToolCard.astro';
import BlogCard from '../components/BlogCard.astro';
import ResourceCard from '../components/ResourceCard.astro';
import Badge from '../components/Badge.astro';
import StatGrid from '../components/StatGrid.astro';
import SkillGroupGrid from '../components/SkillGroupGrid.astro';
import SkillMarquee from '../components/SkillMarquee.astro';
import CodeCard from '../components/CodeCard.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { ENGINEERING_FOCUS, SITE } from '../data/site';
import { TONES, toneAt } from '../lib/tone';

const BADGE_CYCLE = ['accent', 'violet', 'cyan', 'emerald', 'amber', 'rose'] as const;
import { HERO_STATS, EXPERIENCE_STATS, EXPERIENCE, CERTIFICATIONS, FOCUS_AREAS, RESUME_PDF_URL } from '../data/resume';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 4);

const allTools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
const featuredTools = allTools.slice(0, 4);

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const resources = (await getCollection('resources')).slice(0, 3);

function toPascalCase(kebab: string) {
  return kebab
    .split('-')
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join('');
}
const iconMap = icons as unknown as Record<string, typeof icons.Wrench>;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.fullName,
  url: SITE.url,
  jobTitle: 'Backend Software Engineer',
  description: SITE.description,
};
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  keywords={['portfolio', 'AI', 'developer tools', 'JD Decoder', 'Ext Decoder', 'Log Timeline Visualizer', 'CodeKami']}
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="relative border-b border-border">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="bg-dots absolute inset-0 opacity-50"></div>
      <div class="aurora-blob -right-24 -top-32 h-[30rem] w-[30rem]" style="background: var(--color-accent)"></div>
      <div class="aurora-blob left-[6%] top-[34%] h-[22rem] w-[22rem]" style="background: var(--color-tone-violet); animation-delay: -7s; opacity: 0.28"></div>
      <div class="aurora-blob -bottom-24 right-[24%] h-[20rem] w-[20rem]" style="background: var(--color-tone-cyan); animation-delay: -13s; opacity: 0.24"></div>
    </div>

    <Container class="relative grid gap-12 py-20 sm:py-28 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div class="fade-in-up">
        <span class="inline-flex items-center gap-2 rounded-full bg-accent-soft px-3 py-1 font-mono text-xs uppercase tracking-[0.2em] text-accent">
          <span class="relative inline-flex h-2 w-2 text-accent" aria-hidden="true">
            <span class="pulse-ring absolute inset-0 rounded-full"></span>
            <span class="relative h-2 w-2 rounded-full bg-accent"></span>
          </span>
          Backend Software Engineer
        </span>
        <h1 class="mt-5 text-balance font-display text-4xl font-medium leading-[1.05] sm:text-6xl">
          Hi, I'm <span class="text-gradient">{SITE.fullName}</span>
        </h1>
        <p class="mt-4 text-balance text-xl text-fg-muted">
          I build scalable backend systems and share engineering knowledge.
        </p>
        <p class="mt-4 max-w-xl text-balance text-fg-muted">
          4+ years of experience designing and building distributed systems using Java, Spring Boot,
          Microservices, Kafka, and AWS, with a growing focus on developer tools and applied AI.
        </p>
        <p class="mt-5 inline-flex items-center gap-2 whitespace-nowrap rounded-xl border border-border bg-surface/70 px-3 py-2 font-mono text-xs backdrop-blur sm:gap-2.5 sm:px-3.5 sm:text-sm">
          <Terminal class="h-4 w-4 text-tone-emerald" aria-hidden="true" />
          <span class="text-fg-muted">I like working on</span>
          <span class="rotator font-medium text-accent">
            <span>distributed systems</span>
            <span>event-driven services</span>
            <span>developer tools</span>
            <span>AI-assisted tooling</span>
          </span>
        </p>
        <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap sm:gap-4 [&>a]:w-full sm:[&>a]:w-auto">
          <Button href="/projects" size="lg" showArrow>
            <Rocket class="h-4 w-4" aria-hidden="true" />
            View My Projects
          </Button>
          <Button href="/tools" size="lg" variant="secondary">
            <Wrench class="h-4 w-4" aria-hidden="true" />
            Explore My Tools
          </Button>
          <Button href={RESUME_PDF_URL} size="lg" variant="secondary">
            <Download class="h-4 w-4" aria-hidden="true" />
            Download Resume
          </Button>
        </div>
        <SocialLinks class="mt-8" includeEmail />
      </div>

      <div class="relative order-first lg:order-none" data-reveal>
        <div class="relative mx-auto max-w-[15rem] sm:max-w-xs lg:mb-16 lg:max-w-md">
          <div class="pointer-events-none absolute -inset-8 rounded-[3rem] bg-gradient-to-br from-accent/30 via-tone-violet/25 to-tone-cyan/25 blur-3xl" aria-hidden="true"></div>
          <div class="gradient-ring relative rounded-[1.75rem] p-[3px] shadow-2xl">
            <div class="aspect-square overflow-hidden rounded-3xl bg-bg">
              <ProfilePhoto size={640} priority />
            </div>
          </div>

          <span class="animate-float absolute hidden lg:inline-flex -right-6 top-10 z-10 items-center gap-2 rounded-full border border-border bg-bg/90 px-3 py-1.5 text-xs font-medium shadow-lg backdrop-blur" style="animation-duration: 6.5s" aria-hidden="true">
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-tone-emerald-soft text-tone-emerald"><Leaf class="h-3 w-3" /></span>
            Spring Boot
          </span>
          <span class="animate-float absolute hidden lg:inline-flex -left-8 top-[30%] z-10 items-center gap-2 rounded-full border border-border bg-bg/90 px-3 py-1.5 text-xs font-medium shadow-lg backdrop-blur" style="animation-duration: 7.5s; animation-delay: -2s" aria-hidden="true">
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-tone-violet-soft text-tone-violet"><Workflow class="h-3 w-3" /></span>
            Kafka
          </span>
          <span class="animate-float absolute hidden lg:inline-flex -right-8 top-[52%] z-10 items-center gap-2 rounded-full border border-border bg-bg/90 px-3 py-1.5 text-xs font-medium shadow-lg backdrop-blur" style="animation-duration: 5.5s; animation-delay: -4s" aria-hidden="true">
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-tone-amber-soft text-tone-amber"><Coffee class="h-3 w-3" /></span>
            Java
          </span>
          <span class="animate-float absolute hidden lg:inline-flex -bottom-3 right-10 z-10 items-center gap-2 rounded-full border border-border bg-bg/90 px-3 py-1.5 text-xs font-medium shadow-lg backdrop-blur" style="animation-duration: 8s; animation-delay: -1s" aria-hidden="true">
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-tone-cyan-soft text-tone-cyan"><Cloud class="h-3 w-3" /></span>
            AWS
          </span>

          <div class="absolute hidden lg:block -bottom-16 -left-10 z-10 w-56">
            <CodeCard compact />
          </div>
        </div>
      </div>
    </Container>

    <Container class="relative pb-10">
      <StatGrid stats={HERO_STATS} columns={4} />
    </Container>

    <div class="relative pb-14">
      <SkillMarquee />
    </div>
  </section>

  <!-- Featured Work -->
  <section class="border-b border-border py-20">
    <Container>
      <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading icon="rocket" tone="blue" eyebrow="Featured work" title="Things I've built" description="A selection of projects that solve real problems end to end." />
        <Button href="/projects" variant="ghost" showArrow>All projects</Button>
      </div>
      <div data-reveal-group class="mt-12 grid gap-6 lg:grid-cols-2">
        {featuredProjects.map((project, i) => <ProjectCard project={project} size={i === 0 ? 'large' : 'default'} />)}
      </div>
    </Container>
  </section>

  <!-- Experience -->
  <section class="border-b border-border py-20">
    <Container>
      <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading icon="briefcase" tone="violet" eyebrow="Experience" title="Where I've worked" description="Backend roles building financial and trading platforms at scale." />
        <Button href="/resume" variant="ghost" showArrow>Full resume</Button>
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-[1.3fr_1fr]">
        <div data-reveal-group class="space-y-10 border-l-2 border-tone-violet/30 pl-6">
          {
            EXPERIENCE.map((role) => (
              <div class="relative">
                <span class:list={['absolute -left-[31px] top-1.5 h-4 w-4', role.end === 'Present' ? 'text-accent' : 'text-tone-violet']}>
                  {role.end === 'Present' && <span class="pulse-ring absolute inset-0 rounded-full" aria-hidden="true" />}
                  <span
                    class:list={[
                      'relative flex h-4 w-4 items-center justify-center rounded-full',
                      role.end === 'Present' ? 'bg-accent text-accent-fg' : 'bg-tone-violet-soft',
                    ]}
                  >
                    <Briefcase class="h-2.5 w-2.5" aria-hidden="true" />
                  </span>
                </span>
                <p class="font-mono text-xs text-fg-muted">{role.start} – {role.end}</p>
                <h3 class="mt-1 font-display text-lg font-medium">{role.title}</h3>
                <p class="text-sm text-accent">{role.company} · {role.location}</p>
                <ul class="mt-3 space-y-2">
                  {role.bullets.slice(0, 3).map((bullet) => (
                    <li class="flex gap-2 text-sm text-fg-muted">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-fg-muted" aria-hidden="true" />
                      {bullet}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div data-reveal class="space-y-6">
          <div class="grid grid-cols-2 gap-4">
            {
              EXPERIENCE_STATS.map((stat, i) => {
                const Icon = iconMap[toPascalCase(stat.icon)] ?? icons.Zap;
                const tone = TONES[toneAt(i + 1)];
                return (
                  <div class:list={['hover-glow group rounded-2xl border border-border bg-surface p-5', tone.spot]}>
                    <span class:list={['inline-flex h-9 w-9 items-center justify-center rounded-xl transition-transform duration-300 group-hover:rotate-[-8deg] group-hover:scale-110', tone.chip]}>
                      <Icon class="h-[18px] w-[18px]" aria-hidden="true" />
                    </span>
                    <p data-count class:list={['mt-3 font-display text-xl font-medium tabular-nums', tone.text]}>{stat.value}</p>
                    <p class="mt-1 text-xs text-fg-muted">{stat.label}</p>
                  </div>
                );
              })
            }
          </div>

          <div class="rounded-2xl border border-border bg-surface p-5">
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-fg-muted">Technologies I work with</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {ENGINEERING_FOCUS.map((tag, i) => <Badge variant={BADGE_CYCLE[i % BADGE_CYCLE.length]}>{tag}</Badge>)}
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Tech Arsenal -->
  <section class="border-b border-border py-20">
    <Container>
      <div data-reveal>
        <SectionHeading icon="layers" tone="cyan" eyebrow="My tech arsenal" title="Technologies I use" description="The stack I reach for when building real systems, grouped the way I actually think about it." />
      </div>
      <SkillGroupGrid compact class="mt-12" />
    </Container>
  </section>

  <!-- Tools -->
  <section class="border-b border-border py-20">
    <Container>
      <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading icon="wrench" tone="emerald" eyebrow="Tools" title="Tools I build" description="Small, useful software designed to solve specific problems." />
        <Button href="/tools" variant="ghost" showArrow>Explore all tools</Button>
      </div>
      <div data-reveal-group class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {featuredTools.map((tool) => <ToolCard tool={tool} />)}
      </div>
    </Container>
  </section>

  <!-- Latest writing (hidden until the first post exists) -->
  {
    latestPosts.length > 0 && (
      <section class="border-b border-border py-20">
        <Container>
          <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
            <SectionHeading icon="pen-line" tone="amber" eyebrow="Writing" title="Latest from the blog" description="Notes on backend engineering, systems, and things I'm building." />
            <Button href="/blog" variant="ghost" showArrow>Read the blog</Button>
          </div>
          <div data-reveal-group class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {latestPosts.map((post) => <BlogCard post={post} />)}
          </div>
        </Container>
      </section>
    )
  }

  <!-- Certifications -->
  <section class="border-b border-border py-20">
    <Container>
      <div data-reveal>
        <SectionHeading icon="award" tone="amber" eyebrow="Credentials" title="Certifications & awards" />
      </div>
      <div data-reveal-group class="mt-10 grid gap-4 sm:grid-cols-3">
        {
          CERTIFICATIONS.map((cert, i) => {
            const Icon = iconMap[toPascalCase(cert.icon)] ?? icons.Award;
            const tone = TONES[(['amber', 'emerald', 'violet'] as const)[i % 3]];
            return (
              <div class:list={['hover-glow group flex items-start gap-3 rounded-2xl border border-border bg-surface p-5', tone.spot]}>
                <span class:list={['inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl transition-transform duration-300 group-hover:rotate-[-8deg] group-hover:scale-110', tone.chip]}>
                  <Icon class="h-5 w-5" aria-hidden="true" />
                </span>
                <div>
                  <p class="font-medium">{cert.name}</p>
                  <p class="mt-0.5 text-sm text-fg-muted">{cert.issuer}</p>
                </div>
              </div>
            );
          })
        }
      </div>
    </Container>
  </section>

  <!-- Resources (hidden until a resource exists) -->
  {
    resources.length > 0 && (
      <section class="border-b border-border py-20">
        <Container>
          <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
            <SectionHeading icon="library" tone="rose" eyebrow="Resources" title="Free resources" description="Cheat sheets, guides, and templates worth keeping handy." />
            <Button href="/resources" variant="ghost" showArrow>Browse resources</Button>
          </div>
          <div data-reveal-group class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {resources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </Container>
      </section>
    )
  }

  <!-- Currently focused on -->
  <section class="border-b border-border py-20">
    <Container>
      <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading icon="sparkles" tone="violet" eyebrow="Currently focused on" title="What's on my mind lately" />
        <Button href="/about" variant="ghost" showArrow>More about me</Button>
      </div>
      <div data-reveal-group class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          FOCUS_AREAS.map((item, i) => {
            const Icon = iconMap[toPascalCase(item.icon)] ?? icons.Sparkles;
            const tone = TONES[toneAt(i + 2)];
            return (
              <div class:list={['hover-glow group flex items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3', tone.spot]}>
                <span class:list={['inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg transition-transform duration-300 group-hover:rotate-[-8deg] group-hover:scale-110', tone.chip]}>
                  <Icon class="h-[18px] w-[18px]" aria-hidden="true" />
                </span>
                <span class="text-sm font-medium">{item.label}</span>
              </div>
            );
          })
        }
      </div>
    </Container>
  </section>

  <!-- Final CTA -->
  <section class="relative overflow-hidden py-24">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="bg-dots absolute inset-0 opacity-40"></div>
      <div class="aurora-blob left-[12%] -top-20 h-80 w-80" style="background: var(--color-accent)"></div>
      <div class="aurora-blob right-[10%] top-8 h-72 w-72" style="background: var(--color-tone-violet); animation-delay: -9s; opacity: 0.3"></div>
    </div>
    <Container narrow data-reveal class="relative text-center">
      <span class="mx-auto inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-accent to-tone-violet text-white shadow-[0_10px_30px_-8px_var(--color-accent)]">
        <Lightbulb class="h-7 w-7" aria-hidden="true" />
      </span>
      <h2 class="mt-6 text-balance font-display text-3xl font-medium sm:text-5xl">
        Have an idea <span class="text-gradient">worth building?</span>
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-fg-muted">
        I'm always interested in hard backend problems and useful tools worth building. Reach out or take
        a look at what I've already shipped.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button href="/contact" size="lg" showArrow>
          <Mail class="h-4 w-4" aria-hidden="true" />
          Get in touch
        </Button>
        <Button href="/projects" size="lg" variant="secondary">
          <FolderKanban class="h-4 w-4" aria-hidden="true" />
          Explore my work
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
