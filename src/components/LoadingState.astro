---
interface Props {
  rows?: number;
  class?: string;
}

const { rows = 3, class: className = '' } = Astro.props;
---

<div class:list={['grid gap-6 sm:grid-cols-2 lg:grid-cols-3', className]} role="status" aria-label="Loading">
  {
    Array.from({ length: rows }).map(() => (
      <div class="animate-pulse overflow-hidden rounded-2xl border border-border bg-surface">
        <div class="aspect-video bg-surface-hover" />
        <div class="space-y-3 p-6">
          <div class="h-4 w-2/3 rounded bg-surface-hover" />
          <div class="h-3 w-full rounded bg-surface-hover" />
          <div class="h-3 w-4/5 rounded bg-surface-hover" />
        </div>
      </div>
    ))
  }
</div>
