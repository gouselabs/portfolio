---
import { ServerCrash } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import { SITE } from '../data/site';
---

<BaseLayout title="Something went wrong" description="An unexpected error occurred." noindex>
  <Container narrow class="flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <span class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-warning-soft text-warning">
      <ServerCrash class="h-7 w-7" aria-hidden="true" />
    </span>
    <p class="mt-6 font-display text-6xl font-medium text-warning">500</p>
    <h1 class="mt-2 text-balance font-display text-4xl font-medium sm:text-5xl">Something went wrong</h1>
    <p class="mt-4 max-w-md text-fg-muted">
      An unexpected error occurred on this page. Try refreshing, or head back home. If it keeps
      happening, <a href={`mailto:${SITE.email}`} class="text-accent underline underline-offset-4">let me know</a>.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Button href="/" showArrow>Back to home</Button>
      <Button href="/contact" variant="secondary">Contact</Button>
    </div>
  </Container>
</BaseLayout>
