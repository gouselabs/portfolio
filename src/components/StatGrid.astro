---
import { resolveIcon } from '../lib/icons';
import { TONES, toneAt } from '../lib/tone';

interface Stat {
  icon: string;
  value: string;
  label: string;
}

interface Props {
  stats: readonly Stat[];
  columns?: 3 | 4 | 6;
  class?: string;
}

const { stats, columns = 4, class: className = '' } = Astro.props;

const colClasses = {
  3: 'sm:grid-cols-3',
  4: 'sm:grid-cols-4',
  6: 'sm:grid-cols-3 lg:grid-cols-6',
};
---

<div data-reveal-group class:list={['grid grid-cols-2 gap-4', colClasses[columns], className]}>
  {
    stats.map((stat, i) => {
      const Icon = resolveIcon(stat.icon);
      const tone = TONES[toneAt(i)];
      return (
        <div class:list={['hover-glow group rounded-2xl border border-border bg-surface p-5 text-center', tone.spot]}>
          <span class:list={['mx-auto inline-flex h-10 w-10 items-center justify-center rounded-xl transition-transform duration-300 group-hover:rotate-[-8deg] group-hover:scale-110', tone.chip]}>
            <Icon class="h-5 w-5" aria-hidden="true" />
          </span>
          <p data-count class:list={['mt-3 font-display text-2xl font-medium tabular-nums', tone.text]}>{stat.value}</p>
          <p class="mt-1 text-xs text-fg-muted">{stat.label}</p>
        </div>
      );
    })
  }
</div>
