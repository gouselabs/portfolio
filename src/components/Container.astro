---
interface Props {
  class?: string;
  as?: keyof HTMLElementTagNameMap;
  narrow?: boolean;
}

const { class: className = '', as: Tag = 'div', narrow = false } = Astro.props;
---

<Tag class:list={['mx-auto w-full px-5 sm:px-8 lg:px-12', narrow ? 'max-w-3xl' : 'max-w-(--container-page)', className]}>
  <slot />
</Tag>
