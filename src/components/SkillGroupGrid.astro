---
import { SKILL_GROUPS } from '../data/resume';
import { resolveIcon } from '../lib/icons';
import { TONES, toneAt } from '../lib/tone';
import * as lucide from '@lucide/astro';

interface Props {
  class?: string;
  compact?: boolean;
}

const { class: className = '', compact = false } = Astro.props;

const groups = compact ? SKILL_GROUPS.slice(0, 6) : SKILL_GROUPS;
---

<div data-reveal-group class:list={['grid gap-5 sm:grid-cols-2', compact ? 'lg:grid-cols-3' : '', className]}>
  {
    groups.map((group, i) => {
      const Icon = resolveIcon(group.icon, lucide.Wrench);
      const tone = TONES[toneAt(i)];
      return (
        <div class:list={['hover-glow group rounded-2xl border border-border bg-surface p-5', tone.spot]}>
          <div class="flex items-center gap-2.5">
            <span class:list={['inline-flex h-9 w-9 items-center justify-center rounded-xl transition-transform duration-300 group-hover:rotate-[-8deg] group-hover:scale-110', tone.chip]}>
              <Icon class="h-[18px] w-[18px]" aria-hidden="true" />
            </span>
            <p class="font-medium">{group.label}</p>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class:list={['inline-flex items-center rounded-full px-3 py-1 font-mono text-xs transition-transform duration-200 hover:-translate-y-0.5', tone.chip]}>
                {skill}
              </span>
            ))}
          </div>
        </div>
      );
    })
  }
</div>
