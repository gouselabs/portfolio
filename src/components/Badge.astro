---
import { TONES, type Tone } from '../lib/tone';

type Variant = 'default' | 'accent' | 'outline' | 'success' | 'warning' | Exclude<Tone, 'blue'>;

interface Props {
  variant?: Variant;
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variants: Record<string, string> = {
  default: 'bg-surface-hover text-fg-muted',
  accent: TONES.blue.chip,
  outline: 'border border-border text-fg-muted',
  success: 'bg-success-soft text-success',
  warning: 'bg-warning-soft text-warning',
  violet: TONES.violet.chip,
  cyan: TONES.cyan.chip,
  emerald: TONES.emerald.chip,
  amber: TONES.amber.chip,
  rose: TONES.rose.chip,
};
---

<span class:list={['inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium font-mono tracking-wide', variants[variant], className]}>
  <span class:list={['h-1.5 w-1.5 rounded-full', variant === 'success' ? 'bg-success' : variant === 'warning' ? 'bg-warning' : 'hidden']} aria-hidden="true" />
  <slot />
</span>
