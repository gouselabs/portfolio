---
interface Props {
  variant?: 'default' | 'accent' | 'outline' | 'success' | 'warning';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variants = {
  default: 'bg-surface text-fg-muted',
  accent: 'bg-accent-soft text-accent',
  outline: 'border border-border text-fg-muted',
  success: 'bg-success-soft text-success',
  warning: 'bg-warning-soft text-warning',
};
---

<span class:list={['inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium font-mono tracking-wide', variants[variant], className]}>
  <span class:list={['h-1.5 w-1.5 rounded-full', variant === 'success' ? 'bg-success' : variant === 'warning' ? 'bg-warning' : 'hidden']} aria-hidden="true" />
  <slot />
</span>
