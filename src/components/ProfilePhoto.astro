---
import { Image } from 'astro:assets';
import profileSrc from '../assets/images/profile.png';

interface Props {
  class?: string;
  size?: number;
  priority?: boolean;
}

const { class: className = '', size = 480, priority = false } = Astro.props;
---

<Image
  src={profileSrc}
  alt="Gouse Shaikh"
  width={size}
  height={size}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  class:list={['h-full w-full object-cover', className]}
/>
