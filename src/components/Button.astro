---
import { ArrowRight } from '@lucide/astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  class?: string;
  showArrow?: boolean;
  disabled?: boolean;
  type?: 'button' | 'submit';
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  showArrow = false,
  disabled = false,
  type = 'button',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-medium transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2';

const variants = {
  primary: 'bg-accent text-accent-fg shadow-[0_4px_16px_-4px_var(--color-accent)] hover:bg-accent-hover hover:-translate-y-0.5 hover:shadow-[0_8px_24px_-6px_var(--color-accent)]',
  secondary: 'border border-border text-fg hover:border-accent hover:text-accent',
  ghost: 'text-fg-muted hover:text-fg',
};

const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-6 py-3.5 text-base',
};

const disabledClasses = 'pointer-events-none opacity-50';

const classes = [base, variants[variant], sizes[size], disabled ? disabledClasses : '', className].join(' ');
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} type={!href ? type : undefined} aria-disabled={disabled || undefined}>
  <slot />
  {showArrow && <ArrowRight class="h-4 w-4" aria-hidden="true" />}
</Tag>
