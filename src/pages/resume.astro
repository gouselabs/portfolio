---
import { getCollection } from 'astro:content';
import * as icons from '@lucide/astro';
import { Download, Briefcase, GraduationCap, Mail, Phone, MapPin } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import StatGrid from '../components/StatGrid.astro';
import SkillGroupGrid from '../components/SkillGroupGrid.astro';
import { SITE } from '../data/site';
import { SUMMARY, EXPERIENCE, EDUCATION, CERTIFICATIONS, HERO_STATS, RESUME_PDF_URL } from '../data/resume';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order).slice(0, 4);

function toPascalCase(kebab: string) {
  return kebab
    .split('-')
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join('');
}
const iconMap = icons as unknown as Record<string, typeof icons.Wrench>;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.fullName,
  jobTitle: 'Backend Software Engineer',
  url: SITE.url,
  email: SITE.email,
  address: { '@type': 'PostalAddress', addressLocality: SITE.location },
};
---

<BaseLayout
  title="Resume"
  description={`Profile summary, experience, and skills for ${SITE.fullName}.`}
  keywords={['Gouse Shaikh resume', 'backend engineer CV', 'Java resume', 'Spring Boot resume', 'download resume']}
  structuredData={structuredData}
>
  <Container class="py-16 sm:py-24">
    <div data-reveal class="flex flex-wrap items-start justify-between gap-6">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-2 rounded-full bg-accent-soft px-3 py-1 font-mono text-xs uppercase tracking-[0.2em] text-accent"><span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />Resume</span>
        <h1 class="mt-4 text-balance font-display text-4xl font-medium sm:text-5xl">{SITE.fullName}</h1>
        <p class="mt-2 text-fg-muted">Backend Software Engineer · Java · Spring Boot · Kafka · Microservices</p>
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-fg-muted">
          <span class="inline-flex items-center gap-1.5"><MapPin class="h-3.5 w-3.5" aria-hidden="true" />{SITE.location}</span>
          <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-1.5 hover:text-fg"><Mail class="h-3.5 w-3.5" aria-hidden="true" />{SITE.email}</a>
          <a href={`tel:${SITE.phone.replace(/\s+/g, '')}`} class="inline-flex items-center gap-1.5 hover:text-fg"><Phone class="h-3.5 w-3.5" aria-hidden="true" />{SITE.phone}</a>
        </div>
      </div>

      <Button href={RESUME_PDF_URL} size="lg" showArrow={false}>
        <Download class="h-4 w-4" aria-hidden="true" />
        Download PDF
      </Button>
    </div>

    <p data-reveal class="mt-10 max-w-3xl text-lg text-fg-muted">{SUMMARY}</p>

    <StatGrid stats={HERO_STATS} class="mt-10" />

    <div class="mt-14">
      <SectionHeading eyebrow="Experience" title="Work experience" />
      <div data-reveal-group class="mt-8 space-y-10 border-l-2 border-accent/30 pl-6">
        {
          EXPERIENCE.map((role) => (
            <div class="relative">
              <span class="absolute -left-[31px] top-1.5 flex h-4 w-4 items-center justify-center rounded-full bg-accent-soft text-accent">
                <Briefcase class="h-2.5 w-2.5" aria-hidden="true" />
              </span>
              <p class="font-mono text-xs text-fg-muted">{role.start} – {role.end}</p>
              <h3 class="mt-1 font-display text-lg font-medium">{role.title}</h3>
              <p class="text-sm text-accent">{role.company} · {role.location}</p>
              <ul class="mt-3 space-y-2">
                {role.bullets.map((bullet) => (
                  <li class="flex gap-2 text-sm text-fg-muted">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-fg-muted" aria-hidden="true" />
                    {bullet}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-14">
      <SectionHeading eyebrow="Skills" title="Technical skills" />
      <SkillGroupGrid class="mt-8" />
    </div>

    <div class="mt-14">
      <SectionHeading eyebrow="Projects" title="Selected projects" />
      <ul data-reveal-group class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          projects.map((project) => (
            <li>
              <a href={`/projects/${project.id}`} class="hover-glow block rounded-xl border border-border bg-surface p-4">
                <p class="font-medium">{project.data.title}</p>
                <p class="mt-1 text-sm text-fg-muted">{project.data.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-14 grid gap-10 sm:grid-cols-2">
      <div>
        <SectionHeading eyebrow="Education" title="Education" />
        <div class="mt-8 flex gap-3">
          <span class="mt-1 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent">
            <GraduationCap class="h-4 w-4" aria-hidden="true" />
          </span>
          <div>
            <p class="font-mono text-xs text-fg-muted">{EDUCATION.start} – {EDUCATION.end}</p>
            <h3 class="mt-1 font-display text-base font-medium">{EDUCATION.degree}</h3>
            <p class="text-sm text-fg-muted">{EDUCATION.institution}</p>
            <p class="mt-1 text-sm text-accent">{EDUCATION.detail}</p>
          </div>
        </div>
      </div>

      <div>
        <SectionHeading eyebrow="Certifications" title="Certifications & awards" />
        <ul data-reveal-group class="mt-8 space-y-3">
          {
            CERTIFICATIONS.map((cert) => {
              const Icon = iconMap[toPascalCase(cert.icon)] ?? icons.Award;
              return (
                <li class="flex gap-3 text-sm">
                  <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent">
                    <Icon class="h-4 w-4" aria-hidden="true" />
                  </span>
                  <span class="pt-2">
                    <span class="block font-medium text-fg">{cert.name}</span>
                    <span class="text-fg-muted">{cert.issuer}</span>
                  </span>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>

    <div class="mt-14 rounded-2xl border border-border bg-surface p-8 text-center">
      <h2 class="font-display text-xl font-medium">Get in touch</h2>
      <p class="mt-2 text-fg-muted">{SITE.email} · {SITE.phone}</p>
      <Button href="/contact" class="mt-6" showArrow>Contact page</Button>
    </div>
  </Container>
</BaseLayout>
