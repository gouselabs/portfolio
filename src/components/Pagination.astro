---
import { ChevronLeft, ChevronRight } from '@lucide/astro';

interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;

function pageHref(page: number) {
  if (page === 1) return basePath;
  return `${basePath.replace(/\/$/, '')}/${page}`;
}
---

{
  totalPages > 1 && (
    <nav aria-label="Pagination" class="flex items-center justify-center gap-2 pt-4">
      <a
        href={currentPage > 1 ? pageHref(currentPage - 1) : undefined}
        aria-disabled={currentPage <= 1}
        class:list={[
          'inline-flex h-9 w-9 items-center justify-center rounded-full border border-border',
          currentPage <= 1 ? 'pointer-events-none opacity-40' : 'hover:border-fg',
        ]}
        aria-label="Previous page"
      >
        <ChevronLeft class="h-4 w-4" aria-hidden="true" />
      </a>

      {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
        <a
          href={pageHref(page)}
          aria-current={page === currentPage ? 'page' : undefined}
          class:list={[
            'inline-flex h-9 w-9 items-center justify-center rounded-full text-sm font-mono transition-colors',
            page === currentPage ? 'bg-fg text-bg' : 'border border-border text-fg-muted hover:border-fg hover:text-fg',
          ]}
        >
          {page}
        </a>
      ))}

      <a
        href={currentPage < totalPages ? pageHref(currentPage + 1) : undefined}
        aria-disabled={currentPage >= totalPages}
        class:list={[
          'inline-flex h-9 w-9 items-center justify-center rounded-full border border-border',
          currentPage >= totalPages ? 'pointer-events-none opacity-40' : 'hover:border-fg',
        ]}
        aria-label="Next page"
      >
        <ChevronRight class="h-4 w-4" aria-hidden="true" />
      </a>
    </nav>
  )
}
