---
import { getCollection } from 'astro:content';
import { Store } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import EmptyState from '../../components/EmptyState.astro';
import ProductCard from '../../components/ProductCard.astro';
import { SITE } from '../../data/site';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${SITE.brand} Store`,
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/store/${p.id}`, SITE.url).toString(),
    name: p.data.title,
  })),
};
---

<BaseLayout
  title="Store"
  description="Screen-free activity books for kids: coding worksheets, robot brain challenges and detective puzzles, made by Gouse Labs."
  keywords={['kids activity books', 'screen-free activity book', 'kids coding worksheets', 'logic puzzles for kids', 'kids mystery puzzle book', 'STEM activity book']}
  structuredData={structuredData}
>
  <Container class="py-16 sm:py-24">
    <div data-reveal class="max-w-2xl">
      <span class="inline-flex items-center gap-2 rounded-full bg-accent-soft px-3 py-1 font-mono text-xs uppercase tracking-[0.2em] text-accent"><span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />Store</span>
      <h1 class="mt-4 text-balance font-display text-4xl font-medium sm:text-5xl">Store</h1>
      <p class="mt-4 text-fg-muted">
        Screen-free activity books that build logic, observation and problem-solving skills in kids.
        Each one is a digital download, sold securely through Gumroad.
      </p>
    </div>

    {
      products.length === 0 ? (
        <EmptyState
          class="mt-12"
          icon={Store}
          title="No products yet"
          description="Nothing is listed right now. Check back soon."
        />
      ) : (
        <div data-reveal-group class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      )
    }
  </Container>
</BaseLayout>
