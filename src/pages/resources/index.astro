---
import { getCollection } from 'astro:content';
import { Library } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import EmptyState from '../../components/EmptyState.astro';

const resources = (await getCollection('resources')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const categories = ['All', ...new Set(resources.map((r) => r.data.category))];
---

<BaseLayout
  title="Resources"
  description="Useful downloadable material such as cheat sheets, guides and templates."
  keywords={['developer resources', 'cheat sheets', 'free templates']}
>
  <Container class="py-16 sm:py-24">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-2 rounded-full bg-accent-soft px-3 py-1 font-mono text-xs uppercase tracking-[0.2em] text-accent"><span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />Resources</span>
      <h1 class="mt-4 text-balance font-display text-4xl font-medium sm:text-5xl">Resources</h1>
    </div>

    {
      resources.length === 0 ? (
        <EmptyState
          class="mt-12"
          icon={Library}
          title="No resources yet"
          description="I don't have any resources to share right now. Check back soon."
        />
      ) : (
        <>
          <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter resources by category">
            {categories.map((category) => (
              <button
                type="button"
                data-filter={category}
                class:list={[
                  'rounded-full border px-4 py-2 text-sm font-medium transition-colors',
                  category === 'All' ? 'border-fg bg-fg text-bg' : 'border-border text-fg-muted hover:border-fg hover:text-fg',
                ]}
              >
                {category}
              </button>
            ))}
          </div>

          <div id="resource-grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {resources.map((resource) => (
              <div data-resource-item data-category={resource.data.category}>
                <ResourceCard resource={resource} />
              </div>
            ))}
          </div>

          <div id="resources-empty" class="mt-10 hidden">
            <EmptyState title="No resources in this category yet" description="Try a different filter." />
          </div>
        </>
      )
    }
  </Container>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-resource-item]');
  const emptyState = document.getElementById('resources-empty');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;

      buttons.forEach((b) => {
        const active = b === button;
        b.classList.toggle('border-fg', active);
        b.classList.toggle('bg-fg', active);
        b.classList.toggle('text-bg', active);
        b.classList.toggle('border-border', !active);
        b.classList.toggle('text-fg-muted', !active);
      });

      let visibleCount = 0;
      items.forEach((item) => {
        const matches = filter === 'All' || item.dataset.category === filter;
        item.classList.toggle('hidden', !matches);
        if (matches) visibleCount += 1;
      });

      emptyState?.classList.toggle('hidden', visibleCount !== 0);
    });
  });
</script>
