---
import { Inbox } from '@lucide/astro';

interface Props {
  title: string;
  description?: string;
  icon?: typeof Inbox;
  class?: string;
}

const { title, description, icon: Icon = Inbox, class: className = '' } = Astro.props;
---

<div class:list={['flex flex-col items-center gap-3 rounded-2xl border border-dashed border-border px-6 py-16 text-center', className]}>
  <div class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-surface text-fg-muted">
    <Icon class="h-5 w-5" aria-hidden="true" />
  </div>
  <p class="font-display text-lg font-medium">{title}</p>
  {description && <p class="max-w-sm text-sm text-fg-muted">{description}</p>}
  <slot />
</div>
