---
import Container from './Container.astro';
import SocialLinks from './SocialLinks.astro';
import { SITE, FOOTER_LINKS, FOOTER_QUOTE } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <Container class="grid gap-12 py-16 lg:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <a href="/" class="font-display text-lg font-semibold tracking-tight">{SITE.brand}</a>
      <p class="mt-3 text-sm text-fg-muted">{SITE.description}</p>
      <SocialLinks class="mt-6" includeEmail />
    </div>

    {
      FOOTER_LINKS.map((group) => (
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-fg-muted">{group.heading}</p>
          <ul class="mt-4 space-y-3">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-fg-muted transition-colors hover:text-fg">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </Container>

  <Container class="flex flex-col gap-2 border-t border-border py-6 text-xs text-fg-muted sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; {year} {SITE.name}. All rights reserved.</p>
    <p class="font-mono">{FOOTER_QUOTE}</p>
  </Container>
</footer>
