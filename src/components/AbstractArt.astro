---
// Deterministic, license-free abstract line-art used as placeholder cover art.
// Avoids generic stock "programmer at laptop" imagery per the design spec.
// Swap `src` on individual content entries for real photography/screenshots
// once available.
interface Props {
  seed: string;
  variant?: 'nodes' | 'circuit' | 'waves' | 'grid';
  class?: string;
}

const { seed, variant = 'nodes', class: className = '' } = Astro.props;

function hash(str: string): () => number {
  let h = 1779033703 ^ str.length;
  for (let i = 0; i < str.length; i++) {
    h = Math.imul(h ^ str.charCodeAt(i), 3432918353);
    h = (h << 13) | (h >>> 19);
  }
  return () => {
    h = Math.imul(h ^ (h >>> 16), 2246822507);
    h = Math.imul(h ^ (h >>> 13), 3266489909);
    h ^= h >>> 16;
    return (h >>> 0) / 4294967296;
  };
}

const rand = hash(seed);
const W = 800;
const H = 500;

function nodes() {
  const points = Array.from({ length: 9 }, () => ({
    x: 60 + rand() * (W - 120),
    y: 60 + rand() * (H - 120),
  }));
  const lines = points
    .map((p, i) => {
      const next = points[(i + 1 + Math.floor(rand() * 2)) % points.length];
      return `<line x1="${p.x.toFixed(1)}" y1="${p.y.toFixed(1)}" x2="${next.x.toFixed(1)}" y2="${next.y.toFixed(1)}" stroke="var(--color-border)" stroke-width="1.5" />`;
    })
    .join('');
  const circles = points
    .map((p, i) => {
      const r = i % 3 === 0 ? 5 : 3;
      const fill = i % 4 === 0 ? 'var(--color-accent)' : 'var(--color-fg-muted)';
      return `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="${r}" fill="${fill}" opacity="0.9" />`;
    })
    .join('');
  return lines + circles;
}

function circuit() {
  let paths = '';
  for (let i = 0; i < 6; i++) {
    let x = rand() * W;
    let y = rand() * H;
    let d = `M ${x.toFixed(1)} ${y.toFixed(1)}`;
    for (let j = 0; j < 4; j++) {
      if (rand() > 0.5) {
        x += (rand() - 0.5) * 160;
      } else {
        y += (rand() - 0.5) * 120;
      }
      d += ` L ${x.toFixed(1)} ${y.toFixed(1)}`;
    }
    const stroke = i % 3 === 0 ? 'var(--color-accent)' : 'var(--color-border)';
    paths += `<path d="${d}" fill="none" stroke="${stroke}" stroke-width="1.5" stroke-linecap="round" />`;
    paths += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="3" fill="var(--color-fg-muted)" />`;
  }
  return paths;
}

function waves() {
  let paths = '';
  for (let i = 0; i < 5; i++) {
    const amp = 20 + rand() * 40;
    const yBase = 100 + i * 75;
    const phase = rand() * Math.PI * 2;
    let d = `M 0 ${yBase}`;
    for (let x = 0; x <= W; x += 40) {
      const y = yBase + Math.sin(x / 90 + phase) * amp;
      d += ` L ${x} ${y.toFixed(1)}`;
    }
    const stroke = i === 2 ? 'var(--color-accent)' : 'var(--color-border)';
    paths += `<path d="${d}" fill="none" stroke="${stroke}" stroke-width="1.5" />`;
  }
  return paths;
}

function grid() {
  let cells = '';
  const cols = 12;
  const rows = 7;
  const cw = W / cols;
  const ch = H / rows;
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      if (rand() > 0.86) {
        const fill = rand() > 0.6 ? 'var(--color-accent)' : 'var(--color-fg-muted)';
        cells += `<rect x="${(c * cw + 4).toFixed(1)}" y="${(r * ch + 4).toFixed(1)}" width="${(cw - 8).toFixed(1)}" height="${(ch - 8).toFixed(1)}" fill="${fill}" opacity="0.85" />`;
      }
    }
  }
  let lines = '';
  for (let c = 0; c <= cols; c++) {
    lines += `<line x1="${c * cw}" y1="0" x2="${c * cw}" y2="${H}" stroke="var(--color-border)" stroke-width="1" />`;
  }
  for (let r = 0; r <= rows; r++) {
    lines += `<line x1="0" y1="${r * ch}" x2="${W}" y2="${r * ch}" stroke="var(--color-border)" stroke-width="1" />`;
  }
  return lines + cells;
}

const generators = { nodes, circuit, waves, grid };
const content = generators[variant]();
---

<svg
  class={`h-full w-full ${className}`}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-hidden="true"
>
  <rect width={W} height={H} fill="var(--color-surface)" />
  <Fragment set:html={content} />
</svg>
