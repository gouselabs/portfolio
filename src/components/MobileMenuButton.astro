---
import { Menu, X } from '@lucide/astro';
---

<button
  type="button"
  id="mobile-menu-button"
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="mobile-menu"
  class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-fg"
>
  <Menu class="h-4 w-4" data-icon="menu-open" />
  <X class="hidden h-4 w-4" data-icon="menu-close" />
</button>
